#!/usr/bin/env bash
# Developer maintenance only (all user operations are in the UI):
#   ./annotate reset    wipe the database and uploads; the next ./start.sh re-seeds the examples
set -euo pipefail
cd "$(dirname "$0")/backend"
if command -v uv >/dev/null 2>&1; then exec uv run --quiet python -m app.cli "$@"; fi
exec .venv/bin/python -m app.cli "$@"
